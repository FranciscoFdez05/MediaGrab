<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MediaGrab</RootNamespace>
    <AssemblyName>MediaGrab</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Lo exige [LibraryImport] para generar el código de llamada a las APIs de Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Versión e información del ejecutable (Propiedades > Detalles en el Explorador). -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <!-- "1.2.0" en Propiedades > Detalles, sin el hash del commit detrás. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>MediaGrab</Product>
    <AssemblyTitle>MediaGrab</AssemblyTitle>
    <Description>Descarga vídeo (MP4) y audio (MP3) desde cualquier URL con yt-dlp</Description>
    <Company>Francisco</Company>
    <Authors>Francisco</Authors>
    <Copyright>© 2026 Francisco</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <!-- Aplicación de escritorio: icono, manifiesto y configuración de WinForms (ApplicationConfiguration.Initialize). -->
  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <!-- Publicación como un único .exe (ver build.ps1). -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Solo se incluyen los textos del framework en español; reduce el tamaño del .exe. -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaGrab.Tests" />
  </ItemGroup>

</Project>
